# Copia este archivo a .env y rellena tus keys. NUNCA subas .env al repo.

# Finnhub — https://finnhub.io/dashboard  (~60 llamadas/min en tier gratuito)
FINNHUB_API_KEY=

# Twelve Data — https://twelvedata.com/account/api-keys  (~800 llamadas/día)
TWELVEDATA_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key  (~25 llamadas/día)
ALPHAVANTAGE_API_KEY=

# FRED (St. Louis Fed) — https://fred.stlouisfed.org/docs/api/api_key.html  (gratis)
FRED_API_KEY=

# Anthropic (capa de interpretación LLM, Fase 3) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de Claude (opcional). Por defecto claude-sonnet-5-5; alternativa:
# claude-opus-5-5, más capaz y el doble de caro.
# CLAUDE_MODEL=claude-sonnet-5-5

# SEC EDGAR no requiere key, pero exige identificarse en el User-Agent.
# Pon tu nombre y email reales (requisito de la SEC para uso justo de su API):
EDGAR_USER_AGENT="Nombre Apellido email@ejemplo.com"

# Ruta de la base de datos SQLite (opcional; por defecto backend/data/app.db).
# Absoluta, o relativa a backend/ (el backend arranca ahí): «data/app.db», no
# «backend/data/app.db», que acabaría en backend/backend/data/.
# DATABASE_PATH=data/app.db

# Nombres con que se puede llamar al backend (cabecera Host, sin puerto), que se
# AÑADEN a los de esta máquina (localhost, 127.0.0.1 y [::1] siguen siempre: el
# proxy de Vite llama como localhost). Cualquier otro recibe un 400.
# ALLOWED_HOSTS='["mi-mac.local"]'

# Orígenes de la interfaz (lista JSON). Por defecto el Vite local; abierta como
# localhost, 127.0.0.1 o [::1], a través de su proxy cualquier puerto funciona.
# Hace falta si sirves la interfaz de otra forma. Para abrirla con un nombre de
# ALLOWED_HOSTS, Vite también tiene que aceptarlo (`server.allowedHosts`, y
# `server.host` si no resuelve a 127.0.0.1, en frontend/vite.config.ts): por
# defecto lo rechaza antes del proxy. Por http, con ese nombre, el navegador no
# manda Fetch Metadata y solo valen los puertos de esta lista (el 5173 por
# defecto): con Vite en otro puerto, añade ese origen, p. ej.
# "http://mi-mac.local:5174", o hasta las lecturas dan 403.
# CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
